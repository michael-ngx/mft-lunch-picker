# Optional: the Supabase project is built in (src/lib/config.ts). Set these only to point at another project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# For development on your own computer: your own Google Maps key (Maps JavaScript API and
# Places API (New) enabled), restricted to http://localhost:5173/*. The team's key only works
# on the live site. Put this in .env.local, which git ignores.
VITE_GOOGLE_MAPS_KEY=
